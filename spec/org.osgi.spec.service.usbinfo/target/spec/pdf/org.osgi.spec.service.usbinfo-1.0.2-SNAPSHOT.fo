                              </fo:basic-link> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.usbinfo.USBInfoDevice.USB_BINTERFACESUBCLASS">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">USB_BINTERFACESUBCLASS</fo:inline>
                              </fo:basic-link>. Value is 20.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d129e438">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
