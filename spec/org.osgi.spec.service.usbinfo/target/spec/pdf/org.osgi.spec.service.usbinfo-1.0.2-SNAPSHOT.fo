                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The <fo:inline color="inherit"
                          font-family="inherit"
                          letter-spacing="inherit"
                          hyphenate="inherit">???</fo:inline> defines a unified and
    sophisticated way to handle devices attached to a residential gateway or
    devices found in the home network by using various protocols such as USB,
    ZigBee, Z-Wave, KNX, UPnP, etc.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Recently, OSGi is gaining popularity as enabling technology for
    building embedded systems in the residential market as well as other
    Internet-of-Things (IoT) domains. Such systems often have USB interfaces
    and the need of handling USB devices attached to these systems is
    increasing.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
               <fo:inline color="inherit"
                          font-family="inherit"
                          letter-spacing="inherit"
                          hyphenate="inherit">???</fo:inline> defines the concept
    of device categories. This specification defines a device category for USB
    devices.</fo:block>
            <fo:block id="d129e97">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>145.1.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Entities</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d129e99">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d129e100">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">USBInfoDevice</fo:inline> - The representation of a
          USB device. This service provide information defined by the USB
          Implementers Forum, Inc.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="always"
                         id="service.usbinfo-figure-145-1">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Figure 145.1</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>USB Information Device Service Overview Diagram</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block id="d129e106" text-align="center">
                     <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.usbinfo/spec/org.osgi.spec.service.usbinfo/src/main/resources/spec/service_usbinfo_classes.svg)"
                                          width="auto"
                                          height="auto"
                                          content-width="5.000in"
                                          content-height="3.550in"
                                          text-align="center"/>
                  </fo:block>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d129e109">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">USBInfoDevice Service</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>145.2</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>USBInfoDevice Service</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The device services are registered in the OSGi service registry with
    the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.usbinfo.USBInfoDevice">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">USBInfoDevice</fo:inline>
               </fo:basic-link> interface. The service is registered by a USB
    information base driver bundle when a USB device is attached. A USB
    information base driver bundle must implement <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.usbinfo.USBInfoDevice">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">USBInfoDevice</fo:inline>
               </fo:basic-link>
    interface and register the OSGi service under <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.usbinfo.USBInfoDevice">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">USBInfoDevice</fo:inline>
               </fo:basic-link> .
    Refining drivers can find USB devices via <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">USBInfoDevice</fo:inline>
    services and identify the device. The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">USBInfoDevice</fo:inline> service
    has a set of properties.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">USB Specification, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.usbinfo-usbspec">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">[1] <fo:inline font-style="italic">Universal Serial Bus Specification Revision 1.1</fo:inline>
                  </fo:inline>
               </fo:basic-link> ,
    defines that a USB device has USB interface(s). A USB information base
    driver bundle must register <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">USBInfoDevice</fo:inline> services number of
    USB interfaces. A <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">USBInfoDevice</fo:inline> service has information that
    contains a USB device information and a USB interface information.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The USB information base driver may need native drivers such as
    kernel drivers on Linux. This document has a precondition that there are
    native drivers. It is out of scope how to install native drivers.</fo:block>
            <fo:block id="d129e132">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>145.2.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Device Access Category</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The device access category is called "<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">USBInfo</fo:inline>". The
      category name is defined as a value of <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.usbinfo.USBInfoDevice.DEVICE_CATEGORY">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">DEVICE_CATEGORY</fo:inline>
                  </fo:basic-link> constant. It must be used as a part of the<fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">???</fo:inline> service property value on the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.usbinfo.USBInfoDevice">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">USBInfoDevice</fo:inline>
                  </fo:basic-link>
      service. The category defines the following additional service
      properties for the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.usbinfo.USBInfoDevice">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">USBInfoDevice</fo:inline>
                  </fo:basic-link>
      service.</fo:block>
            </fo:block>
            <fo:block id="d129e146">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>145.2.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Service Properties based upon USB Specification</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The USB Specification defines a Device Descriptor. USB devices
      report their attributes using descriptors. The following <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.usbinfo.USBInfoDevice">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">USBInfoDevice</fo:inline>
                  </fo:basic-link>
      service properties use information from the USB device
      descriptor.</fo:block>
               <fo:block xmlns:rx="http://www.renderx.com/XSL/Extensions"
                         space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="auto"
                         id="d129e152">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Table 145.1</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>Service properties of USBInfoDevice service from Device
        Descriptor</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:table border-before-width.conditionality="retain"
                            border-collapse="collapse"
                            table-layout="fixed"
                            width="100%">
                     <fo:table-column column-number="1" column-width="proportional-column-width(3.5)"/>
                     <fo:table-column column-number="2" column-width="proportional-column-width(1)"/>
                     <fo:table-column column-number="3" column-width="proportional-column-width(3.5)"/>
                     <fo:table-column column-number="4" column-width="proportional-column-width(2)"/>
                     <fo:table-header start-indent="0pt" end-indent="0pt">
                        <fo:table-row keep-together.within-column="always"
                                      keep-with-next.within-column="always"
                                      font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>The key of service property</fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Type</fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Description</fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Device Descriptor's Field from USB Spec.</fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                     </fo:table-header>
                     <fo:table-body start-indent="0pt" end-indent="0pt">
                        <fo:table-row keep-together.within-column="always">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">usbinfo.bcdUSB</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">String</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:block space-before.optimum="5pt"
                                           space-before.minimum="5pt"
                                           space-before.maximum="5pt">OPTIONAL property key. The 4-digit BCD
              format.</fo:block>
                                 <fo:block space-before.optimum="5pt"
                                           space-before.minimum="5pt"
                                           space-before.maximum="5pt">Example: "0210"</fo:block>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>bcdUSB</fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                        <fo:table-row keep-together.within-column="always">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">usbinfo.bDeviceClass</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">String</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:block space-before.optimum="5pt"
                                           space-before.minimum="5pt"
                                           space-before.maximum="5pt">MANDATORY property key. Hexadecimal,
              2-digits.</fo:block>
                                 <fo:block space-before.optimum="5pt"
                                           space-before.minimum="5pt"
                                           space-before.maximum="5pt">Example: "ff"</fo:block>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>bDeviceClass</fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                        <fo:table-row keep-together.within-column="always">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">usbinfo.bDeviceSubClass</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
